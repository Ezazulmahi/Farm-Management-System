# Copy to Backend/Model/.env. Never commit the real .env.
# MongoDB Atlas or local: mongodb://127.0.0.1:27017/Farm_Management_System
MONGO_URI=mongodb://127.0.0.1:27017/Farm_Management_System
PORT=5000
NODE_ENV=development
# Comma separated list of frontend origins allowed by CORS
CLIENT_ORIGIN=http://localhost:5173
# Free key from https://www.weatherapi.com/
WEATHER_API_KEY=
# Used only by `npm run create-admin`
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=
